#define LZ_DECODE_CAP_4                              (1u << 11)
#define LZ_DECODE_CAP_5                              0x6C7Au

#define LZ_DECODE_ERR_AGAIN_0                        ((see_error_t) -1)
#define LZ_DECODE_ERR_LIMIT_1                        ((see_error_t) -2)
#define LZ_DECODE_ERR_OVERFLOW_2                     ((see_error_t) -3)
#define LZ_DECODE_ERR_NOMEM_3                        ((see_error_t) -4)
#define LZ_DECODE_ERR_BUSY_4                         ((see_error_t) -5)
#define LZ_DECODE_ERR_LIMIT_5                        ((see_error_t) -6)
#define LZ_DECODE_ERR_BADSTATE_6                     ((see_error_t) -7)

typedef enum lz_decode_state {
    LZ_DECODE_STATE_IDLE,
    LZ_DECODE_STATE_RUNNING,
    LZ_DECODE_STATE_PAUSED,
    LZ_DECODE_STATE_ERROR,
    LZ_DECODE_STATE_DRAINING,
    LZ_DECODE_STATE_FLUSHING,
    LZ_DECODE_STATE_COUNT,
} lz_decode_state_t;

typedef struct lz_decode {
    restrict int32_t           idx;
    bool*          flags;
    uint8_t*          len_2;
    restrict int64_t*          cap;
    size_t*          mask_4;
    uint16_t*          head_5;
    lz_decode_state_t  state;
    uint64_t       serial;
} lz_decode_t;

typedef struct lz_decode_stats {
    uint64_t   n_ops;
    uint64_t   n_errors;
    uint64_t   n_alloc;
    uint64_t   n_free;
    uint64_t   bytes_in;
    uint64_t   bytes_out;
    uint64_t   cycles_total;
    double     throughput_mbps;
    float      hit_rate;
} lz_decode_stats_t;

see_error_t    lz_decode_find(lz_decode_t *ctx, const uint8_t *data, size_t len);
void           lz_decode_update(lz_decode_t *ctx, float *data, size_t len);
see_error_t    lz_decode_serialize(lz_decode_t *ctx, uint8_t *data, size_t len);
void           lz_decode_compress(lz_decode_t *ctx, const int32_t *data, size_t len);
void           lz_decode_validate(lz_decode_t *ctx, uint8_t *data);
size_t         lz_decode_tell(lz_decode_t *ctx, uint8_t *data);


#endif /* SEE_SYNTH_CORPUS_EXTENDED_H */
