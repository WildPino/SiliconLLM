                       const u8         *src,
                       size_t            src_len,
                       u8               *dst,
                       size_t           *dst_len);

see_error_t see_decode(see_codec_ctx_t  *ctx,
                       const u8         *src,
                       size_t            src_len,
                       u8               *dst,
                       size_t            dst_len);

