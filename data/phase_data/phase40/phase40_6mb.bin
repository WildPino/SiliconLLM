        for(int i_ch=0; i_ch<3; i_ch++) {
            int t3_tokens = t3_configs[i_t3];
            int channels = ch_configs[i_ch];
            
            RUN_SWEEP(128);
            RUN_SWEEP(256);
            RUN_SWEEP(512);
            RUN_SWEEP(1024);
        }
    }
    
    free_sweep_context(ctx);
}

