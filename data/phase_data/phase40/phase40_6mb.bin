    if (!data) return;

    // Warmup & initialization
    for (size_t i = 0; i < num_elements; ++i) {
        data[i] = (int)i;
    }

    uint64_t start = get_cycles();
    volatile int sum = 0;
    
    // Sequential read
    for (size_t i = 0; i < num_elements; ++i) {
        sum += data[i];
    }
