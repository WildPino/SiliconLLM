typedef struct {
    Dataset* train_bits[8];
    Dataset* val_bits[8];
    int WARMUP;
    int N_train;
    int N_val;
} SweepContext;

SweepContext* create_sweep_context(int N_train, int N_val) {
    SweepContext* ctx = malloc(sizeof(SweepContext));
    ctx->WARMUP = 2000;
    ctx->N_train = N_train;
    ctx->N_val = N_val;
    for(int b=0; b<8; b++) {
        ctx->train_bits[b] = create_dataset(N_train, 128 + 16); // max features
        ctx->val_bits[b] = create_dataset(N_val, 128 + 16);
    }
    return ctx;
}

void free_sweep_context(SweepContext* ctx) {
    for(int b=0; b<8; b++) {feguarding the social function of the market is what makes the difference between free trade, pure and simple, and a system for improving people' s quality of life.
