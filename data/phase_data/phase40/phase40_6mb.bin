    int offset = e->grid_vectors - 256; // benchmark5 extracted from last 256 blocks
    if (offset < 0) offset = 0;
    
    for(int i = 0; i < 256; i+=32) {
        for(int k=0; k<32; k++) {
            uint8_t bytes[32];
