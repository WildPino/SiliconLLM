void silicon_v0_init(SiliconV0* e, int codebook_seed) {
    srand(codebook_seed);
    for(int b = 0; b < 256; b++) {
        uint8_t vec[32];
        for(int i = 0; i < 32; i++) {
            vec[i] = (rand() % 2) ? 255 : 0;
        }
        e->codebook[b] = _mm256_loadu_si256((__m256i*)vec);
    }
    memset(e->m4_buf, 0, sizeof(e->m4_buf));
    e->m4_head = 0;
    memset(e->state, 0, sizeof(e->state));
}

