void m4_extract_32(int idx, uint8_t byte, float* out) {
    if (idx == 0) memset(hist, 0, 16);
    memmove(hist + 1, hist, 15);
    hist[0] = byte;
    
    memset(out, 0, 32 * sizeof(float));
    for (int t = 0; t < 16; t++) {
