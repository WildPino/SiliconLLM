#ifdef _WIN32
    SetThreadAffinityMask(GetCurrentThread(), 1);
#endif

    printf("=== PHASE 4.C: L2 PERTURBATION LEARNING ===\n\n");
    bench_integrated_throughput();
    
    run_l2_task("XOR-2", 0);
    run_l2_task("Period-7", 1);
    run_l2_task("Echo-5", 2);

    return 0;
}


