        for(int i=0; i<128; i++) codebook_grid[b][i] = _mm256_setzero_si256();
        
        if (enc_type == 0) { // Raw ASCII
            codebook_grid[b][0] = _mm256_set1_epi8(b);
        }
        else if (enc_type == 1) { // Bit-plane
            uint8_t vec[32];
            for(int i=0; i<8; i++) {
                uint8_t val = ((b >> i) & 1) ? 255 : 0;
