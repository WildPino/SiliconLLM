static inline uint64_t get_cycles() {
    unsigned int dummy;
    return __rdtscp(&dummy);
}

// Helper: Hamming distance between two byte arrays
int hamming_distance(uint8_t* a, uint8_t* b, int len) {
    int dist = 0;
    for(int i=0; i<len; i++) {
        uint8_t xor_val = a[i] ^ b[i];
        while(xor_val) {
            dist += xor_val & 1;
            xor_val >>= 1;
        }
    }
    return dist;
}

