    eval_text_metrics(val_bits, w_m4, b_m4, NUM_M4_FEATURES, NUM_WAVE_FEATURES, "M4-only Ridge");
    eval_text_metrics(val_bits, w_wave, b_wave, NUM_WAVE_FEATURES, 0, "Wave-only Ridge");
