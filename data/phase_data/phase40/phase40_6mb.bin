    // --- 2. GLOBAL TARGET SHUFFLE ---
    printf("\n--- Test: Global Target Shuffle ---\n");
    for(int bit=0; bit<8; bit++) {
        for(int i=N_val-1; i>0; i--) {
            int j = rand() % (i+1);
            double temp = ctx.val_bits[bit]->y[i];
            ctx.val_bits[bit]->y[i] = ctx.val_bits[bit]->y[j];
