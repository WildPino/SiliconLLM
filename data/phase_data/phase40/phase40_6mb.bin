    extract_to_datasets(&ctx, text, 0);
    train_and_eval(&ctx, NUM_WAVE_FEATURES, 0, "Wave-current-only", 0);
    
    for(int b=0; b<8; b++) {
        free_dataset(ctx.train_bits[b]);
        free_dataset(ctx.val_bits[b]);
    }
    free(text);
}

