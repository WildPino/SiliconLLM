            uint8_t vec[32] = {0};
            int start = (p % 2 == 0) ? 0 : 16;
            for(int j=0; j<16; j++) vec[start + j] = 255;
            codebook_grid[b][target_block] = _mm256_loadu_si256((__m256i*)vec);
        }
        else if (enc_type == 5) { // One-ncil regulation under Article 152 of the Treaty on the prevention and control of TSEs.
