typedef struct {
    int grid_size;
    int num_zones;
    int topology;
    
    __m256i* state;
    __m256i* new_state;
    __m256i* m4_buf;
    int m4_head;
    
    uint8_t** rule_select; // [num_zones][32]
    __m256i* mask_b0;
    __m256i* mask_b1;
} EngineArit;

