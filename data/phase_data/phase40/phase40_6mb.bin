void generate_balanced_vector(uint8_t* vec) {
    int ones = 16, zeros = 16;
    for(int i=0; i<32; i++) {
        if (ones > 0 && zeros > 0) {
            if (rand() % 2) { vec[i] = 255; ones--; }
            else { vec[i] = 0; zeros--; }
        } else if (ones > 0) { vec[i] = 255; ones--; }
        else { vec[i] = 0; zeros--; }
    }
}

