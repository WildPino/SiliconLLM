    train_and_eval(&ctx, NUM_M4_FEATURES, NUM_WAVE_FEATURES, "M4-readout", 0);
    train_and_eval(&ctx, NUM_WAVE_FEATURES, 0, "Wave-readout-T3", 0);
    free(block_shuffled);
    
    // --- 5. T3 ABLATION (Current-byte only) ---
