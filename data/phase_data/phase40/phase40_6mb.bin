        }
        uint8_t* tmp = state; state = new_state; new_state = tmp;
    }
    end = get_cycles();
    printf("M6 Leaky Integ (Interleaved)  : %.3f cycles/elem\n", (double)(end-start)/(iters * GRID_SIZE));
    
