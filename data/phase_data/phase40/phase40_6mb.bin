        else if (enc_type == 2) { // Random Fixed Codebook
            uint8_t vec[32];
            for(int i=0; i<32; i++) vec[i] = (rand() % 2) ? 255 : 0;
            codebook_grid[b][0] = _mm256_loadu_si256((__m256i*)vec);
        }
        else if (enc_type == 3) { // One-Hot Contiguous 16-cell
