+@ModelBase.register("DeepseekV3ForCausalLM")
+@ModelBase.example("deepseek-ai/DeepSeek-V3")
+class DeepseekV3Model(DeepseekV2Model):
+    """DeepSeek-V3 with opt-in support for its single appended MTP block.
+
+    The default keeps the historic base-only export.  ``--mtp`` writes a
+    standalone draft file: the appended block is remapped to ``blk.26`` and
+    root embedding/head tensors are retained so the runtime can use its
+    existing fallback instead of duplicating the two MTP aliases.
+    """
+
+    model_arch = gguf.MODEL_ARCH.DEEPSEEK2
+    supports_mtp_export = True
+    skip_mtp = True
+    _n_main_layers: int | None = None
+
+    def index_tensors(self, remote_hf_model_id: str | None = None):
+        n_nextn = self.hparams.get("num_nextn_predict_layers", 0)
+        if n_nextn not in (0, 1):
+            raise ValueError(
+                "DeepSeek-V3 MTP export supports exactly one appended NextN "
+                f"layer, got num_nextn_predict_layers={n_nextn!r}"
+            )
+        if self.mtp_only and n_nextn != 1:
+            raise ValueError(
+                "--mtp requires DeepSeek-V3 config num_nextn_predict_layers=1"
+            )
+        type(self)._n_main_layers = self.hparams["num_hidden_layers"]
+        return super().index_tensors(remote_hf_model_id=remote_hf_model_id)
+
+    def __init__(self, *args, **kwargs):
+        super().__init__(*args, **kwargs)
+        n_main_layers = self.hparams["num_hidden_layers"]
+        self.skip_mtp = not self.mtp_only
+        self.block_count = n_main_layers + (1 if self.mtp_only else 0)
+        self.tensor_map = gguf.get_tensor_name_map(self.model_arch, self.block_count)
+
+    @classmethod
+    def filter_tensors(cls, item: tuple[str, Callable[[], Tensor]]) -> tuple[str, Callable[[], Tensor]] | None:
+        if (titem := super().filter_tensors(item)) is None:
+            return None
+        name, gen = titem
+
+        assert cls._n_main_layers is not None
+        match = re.match(r"model\.layers\.(\d+)\.", name)
+        is_mtp = match is not None and int(match.group(1)) >= cls._n_main_layers
+
+        # Preserve the historical V3 base-only default, including --no-mtp.
+        if not cls.mtp_only:
+            return None if is_mtp else (name, gen)
+
+        # ``index_tensors`` accepted a single NextN layer only.
+        if is_mtp:
+            if int(match.group(1)) != cls._n_main_layers:
+                raise ValueError(f"Unexpected DeepSeek-V3 MTP tensor {name!r}")
+            # GigaChat's MTP embedding and shared head are byte-identical to
+            # the root tensors.  Omit the aliases: deepseek2.cpp falls back to
+            # token_embd/output and the standalone draft stores each once.
+            if name in (
+                f"model.layers.{cls._n_main_layers}.embed_tokens.weight",
+                f"model.layers.{cls._n_main_layers}.shared_head.head.weight",
+            ):
+                return None
+            return name, gen
+
+        if name not in (
+            "model.embed_tokens.weight", "model.norm.weight", "lm_head.weight",
+        ):
+            return None
+        return name, gen
+
+    def set_gguf_parameters(self):
+        super().set_gguf_parameters()
+        if self.mtp_only:
+            # index_tensors() has already rejected zero or multi-block NextN.
+            self.gguf_writer.add_nextn_predict_layers(1)
+
+
